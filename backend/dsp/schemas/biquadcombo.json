{
  "BiquadCombo": {
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "ButterworthHighpass",
          "ButterworthLowpass",
          "LinkwitzRileyHighpass",
          "LinkwitzRileyLowpass",
          "NPointPeq",
          "GraphicEqualizer",
          "Tilt"
        ]
      }
    },
    "required": ["type"]
  },
  "ButterworthHighpass": {
    "properties": {
      "type": {
        "enum": ["ButterworthHighpass"]
      },
      "freq": {
        "type": "number",
        "exclusiveMinimum": 0.0
      },
      "order": {
        "type": "integer",
        "exclusiveMinimum": 0
      }
    },
    "required": ["type", "freq", "order"],
    "additionalProperties": false
  },
  "ButterworthLowpass": {
    "properties": {
      "type": {
        "enum": ["ButterworthLowpass"]
      },
      "freq": {
        "type": "number",
        "exclusiveMinimum": 0.0
      },
      "order": {
        "type": "integer",
        "exclusiveMinimum": 0
      }
    },
    "required": ["type", "freq", "order"],
    "additionalProperties": false
  },
  "LinkwitzRileyHighpass": {
    "properties": {
      "type": {
        "enum": ["LinkwitzRileyHighpass"]
      },
      "freq": {
        "type": "number",
        "exclusiveMinimum": 0.0
      },
      "order": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "multipleOf": 2
      }
    },
    "required": ["type", "freq", "order"],
    "additionalProperties": false
  },
  "LinkwitzRileyLowpass": {
    "properties": {
      "type": {
        "enum": ["LinkwitzRileyLowpass"]
      },
      "freq": {
        "type": "number",
        "exclusiveMinimum": 0.0
      },
      "order": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "multipleOf": 2
      }
    },
    "required": ["type", "freq", "order"],
    "additionalProperties": false
  },
  "Tilt": {
    "properties": {
      "type": {
        "enum": ["Tilt"]
      },
      "gain": {
        "type": "number",
        "minimum": -100,
        "Maximum": 100
      }
    },
    "required": ["gain"],
    "additionalProperties": false
  },
  "NPointPeq": {
    "properties": {
      "type": {
        "enum": ["NPointPeq"]
      },
      "bands": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "properties": {
            "freq": {
              "type": "number",
              "exclusiveMinimum": 0.0
            },
            "q": {
              "type": "number",
              "exclusiveMinimum": 0.0
            },
            "gain": {
              "type": "number"
            }
          },
          "required": ["freq", "q", "gain"],
          "additionalProperties": false
        }
      }
    },
    "required": ["type", "bands"],
    "additionalProperties": false
  },
  "GraphicEqualizer": {
    "properties": {
      "type": {
        "enum": ["GraphicEqualizer"]
      },
      "freq_min": {
        "type": ["number", "null"],
        "exclusiveMinimum": 0.0,
        "default": null
      },
      "freq_max": {
        "type": ["number", "null"],
        "exclusiveMinimum": 0.0,
        "default": null
      },
      "gains": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": -40.0,
          "maximim": 40.0
        }
      }
    },
    "required": ["type", "gains"],
    "additionalProperties": false
  }
}
